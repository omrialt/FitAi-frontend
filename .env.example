# Base URL of the FitAi backend API, with no trailing slash.
#
# Vite inlines this at BUILD time, so it must be set in the hosting
# environment BEFORE the build runs. Changing it later requires a redeploy —
# updating the variable alone will not affect an already-built bundle.
#
# Local:      http://localhost:3000
# Production: https://<your-backend-host>
VITE_API_URL=http://localhost:3000
